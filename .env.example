# Copy to .env.local for local dev, and set these in Vercel → Project → Settings → Environment Variables.
# The site runs without any of these (orders log to the server, payment = pay-at-pickup).
# Fill them in to turn on real order emails and, later, online prepayment.

# --- Order / catering emails (Resend) ---
# Get an API key at resend.com, verify thebrothersdeli.com (add the DNS records Resend gives you).
RESEND_API_KEY=
ORDER_EMAIL_TO=thedeli@thebrothersdeli.com
ORDER_EMAIL_FROM=The Brothers Deli <orders@thebrothersdeli.com>

# --- Online prepayment (Payanywhere / North) — optional, add when ready ---
# From the deli's Payanywhere / North gateway account. Until these are set,
# orders are "pay at pickup" at the POS. See lib/payment.ts.
PAYANYWHERE_GATEWAY_URL=
PAYANYWHERE_API_KEY=
PAYANYWHERE_MERCHANT_ID=
