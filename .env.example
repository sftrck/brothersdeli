# Copy to .env.local for local dev, and set these in Vercel → Project → Settings → Environment Variables.
# The site runs without any of these (orders log to the server, payment = pay-at-pickup).
# Fill them in to turn on real order emails and, later, online prepayment.

# --- Order / catering emails (Resend) ---
# Get an API key at resend.com, verify thebrothersdeli.com (add the DNS records Resend gives you).
RESEND_API_KEY=
ORDER_EMAIL_TO=thedeli@thebrothersdeli.com
ORDER_EMAIL_FROM=The Brothers Deli <orders@thebrothersdeli.com>

# --- Online card payments: Payanywhere / North EPX Embedded Checkout (Fields) ---
# Payanywhere is North's brand. Enable North "Online Payments", create an
# Embedded Checkout in the North Embedded Checkout Designer, and copy these three
# values (get the SANDBOX set first for testing, then production). Until they are
# set, the checkout shows "payment being connected" instead of the card form.
# See lib/payment.ts.
NORTH_API_KEY=
NORTH_CHECKOUT_ID=
NORTH_PROFILE_ID=
NORTH_ENV=sandbox

# --- Payanywhere payment webhook (optional) ---
# A secret you choose. Set it here AND include it in the webhook URL you enter in
# Payments Hub:  https://<domain>/api/webhooks/payanywhere?key=<this value>
# The endpoint rejects any POST whose ?key= doesn't match, then emails the deli a
# "payment collected" notice. (Also needs RESEND_API_KEY set to actually send.)
PAYANYWHERE_WEBHOOK_SECRET=
